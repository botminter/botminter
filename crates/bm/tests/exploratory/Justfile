# Exploratory test execution recipes for session lifecycle, bridge & brain lifecycle
# Usage: just -f crates/bm/tests/exploratory/Justfile <phase>
# Full run: just -f crates/bm/tests/exploratory/Justfile all
#
# Tests run on an isolated user account (TEST_USER@localhost) via SSH
# to prevent test cleanup from affecting the operator's home directory.
# This avoids destructive cleanup (rm -rf ~/.claude etc.) hitting the
# operator's real home. The test user's home is disposable.

set positional-arguments
set dotenv-load := false

# ─── Variables ─────────────────────────────────────────────────
# Local paths (operator machine — build + orchestration)
CARGO_ROOT := justfile_directory() + "/../../../.."
LOCAL_REPORT := justfile_directory() + "/REPORT.md"
LOCAL_PHASES := justfile_directory() + "/phases"
LOCAL_LIB := justfile_directory() + "/lib.sh"

# Remote test user (SSH-accessible, isolated home directory)
TEST_USER := "bm-test-user"
TEST_HOST := TEST_USER + "@localhost"

# Remote paths (test user machine — execution)
REMOTE_HOME := "/home/" + TEST_USER
REMOTE_BIN := REMOTE_HOME + "/.local/bin"
REMOTE_STAGING := REMOTE_HOME + "/.bm-exploratory-tests"
REMOTE_PHASES := REMOTE_STAGING + "/phases"
REMOTE_LIB := REMOTE_STAGING + "/lib.sh"
REMOTE_REPORT := REMOTE_STAGING + "/REPORT.md"
REMOTE_ENV := REMOTE_STAGING + "/env.sh"

# Test configuration
TEAM := "exploratory-test"
ORG := "devguyio-bot-squad"
REPO := "exploratory-test-team"
FULL_REPO := ORG + "/" + REPO
PROJECT_REPO := "exploratory-test-project"
FULL_PROJECT_REPO := ORG + "/" + PROJECT_REPO
PROFILE := "agentic-sdlc-planning"
BOARD := "Exploratory Test Board"
TUWUNEL_PORT := env("TUWUNEL_PORT", "8008")

# GitHub credentials
TESTS_GH_TOKEN := env("TESTS_GH_TOKEN", "")

# GitHub App credentials (pre-provisioned bm-test-app)
TESTS_APP_ID := env("TESTS_APP_ID", "")
TESTS_APP_CLIENT_ID := env("TESTS_APP_CLIENT_ID", "")
TESTS_APP_INSTALLATION_ID := env("TESTS_APP_INSTALLATION_ID", "")
TESTS_APP_PRIVATE_KEY_FILE := env("TESTS_APP_PRIVATE_KEY_FILE", "")

# Remote paths derived from test user's HOME
REMOTE_TEAM_DIR := REMOTE_HOME + "/.botminter/workspaces/" + TEAM
REMOTE_TEAM_REPO := REMOTE_TEAM_DIR + "/team"

# ─── Setup ─────────────────────────────────────────────────────

# Build bm from source (local)
build:
    cd {{CARGO_ROOT}} && just build

# Full cleanup: stop processes, destroy containers/volumes, remove GitHub artifacts,
# clear keyring, wipe local config. Idempotent — safe to run repeatedly.
# Ensures a completely clean slate before deploy and test phases.
clean:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Cleaning test environment on {{TEST_HOST}}..."
    # Use Just variables directly (hardcoded into the script) instead of
    # sourcing env.sh, which may not exist on a cold start. This makes
    # clean reliable regardless of deploy state.
    ssh {{TEST_HOST}} 'bash -l -c "
        TEAM=\"{{TEAM}}\"
        ORG=\"{{ORG}}\"
        FULL_REPO=\"{{FULL_REPO}}\"
        BOARD=\"{{BOARD}}\"
        source {{REMOTE_LIB}} 2>/dev/null || true

        # ── Processes ──
        # 1. Graceful stop via bm
        if [ -x {{REMOTE_BIN}}/bm ] && [ -f {{REMOTE_HOME}}/.botminter/config.yml ]; then
            {{REMOTE_BIN}}/bm stop --force --bridge -t $TEAM 2>/dev/null || true
        fi
        # 2. SIGTERM stale bm/ralph/claude processes.
        # Use [x]yz patterns to avoid matching the grep command itself or
        # the bash -l -c "..." shell whose cmdline contains the pattern string.
        for pattern in \"[b]m brain-run\" \"[b]m daemon-run\" \"[b]m daemon\" \"[b]m start\" \"[c]laude-agent-acp\" \"[c]laude.*stream-json\" \"[r]alph loop\" \"[r]alph run\" \"[s]tub-bin/ralph\"; do
            for pid in \$(ps aux | grep \"\$pattern\" | awk \"{print \\\$2}\"); do
                kill \"\$pid\" 2>/dev/null || true
            done
        done
        sleep 2
        # 3. SIGKILL survivors
        for pattern in \"[b]m brain-run\" \"[b]m daemon-run\" \"[b]m daemon\" \"[c]laude-agent-acp\" \"[r]alph loop\" \"[r]alph run\" \"[s]tub-bin/ralph\"; do
            for pid in \$(ps aux | grep \"\$pattern\" | awk \"{print \\\$2}\"); do
                kill -9 \"\$pid\" 2>/dev/null || true
            done
        done

        # ── Container + Volume ──
        podman rm -f bm-tuwunel-$TEAM 2>/dev/null || true
        podman volume rm bm-tuwunel-$TEAM-data 2>/dev/null || true

        # ── GitHub ──
        gh repo delete $FULL_REPO --yes 2>/dev/null || true
        gh repo delete $FULL_PROJECT_REPO --yes 2>/dev/null || true
        PROJ_NUM=\$(gh project list --owner $ORG --format json 2>/dev/null | jq -r \".projects[] | select(.title==\\\"$BOARD\\\") | .number\" 2>/dev/null)
        [ -n \"\$PROJ_NUM\" ] && gh project delete \"\$PROJ_NUM\" --owner $ORG --format json 2>/dev/null || true

        # ── Keyring ──
        if type load_isolated_keyring &>/dev/null && load_isolated_keyring; then
            for u in engineer-alice engineer-bob engineer-carol engineer-pre-existing bmadmin; do
                secret_tool clear service botminter.$TEAM.tuwunel username \$u 2>/dev/null || true
            done
            stop_isolated_keyring 2>/dev/null || true
        fi

        # ── Local state ──
        rm -rf ~/.botminter ~/.config/botminter 2>/dev/null || true
        rm -f {{REMOTE_BIN}}/bm {{REMOTE_BIN}}/bm-agent {{REMOTE_BIN}}/ralph {{REMOTE_BIN}}/claude
        # claude-agent-acp is deployed (not pre-installed); remove if present
        rm -f {{REMOTE_BIN}}/claude-agent-acp

        # ── Port wait ──
        # Kill any conmon process holding the port (podman rm may not release immediately)
        PORT_PID=\$(ss -tlnp sport = :{{TUWUNEL_PORT}} 2>/dev/null | grep -oP 'pid=\K[0-9]+' || true)
        [ -n \"\$PORT_PID\" ] && kill \"\$PORT_PID\" 2>/dev/null || true
        for i in \$(seq 1 15); do
            if ! ss -tlnp 2>/dev/null | grep -q \":{{TUWUNEL_PORT}} \"; then break; fi
            sleep 2
        done
    "' || true
    echo "Clean."

# Deploy binaries + test scripts to the remote test user
deploy: build clean
    #!/usr/bin/env bash
    set -euo pipefail
    # Validate required env vars
    for var in TESTS_GH_TOKEN TESTS_APP_ID TESTS_APP_CLIENT_ID TESTS_APP_INSTALLATION_ID TESTS_APP_PRIVATE_KEY_FILE; do
        if [ -z "${!var:-}" ]; then
            echo "Error: $var env var must be set" >&2
            exit 1
        fi
    done
    echo "Deploying to {{TEST_HOST}}..."
    # Create remote directories
    ssh {{TEST_HOST}} 'mkdir -p {{REMOTE_BIN}} {{REMOTE_PHASES}} ~/.config/github-apps'
    # Copy binaries (bm + bm-agent from build, others from operator's PATH)
    scp -q {{CARGO_ROOT}}/target/debug/bm {{TEST_HOST}}:{{REMOTE_BIN}}/bm
    scp -q {{CARGO_ROOT}}/target/debug/bm-agent {{TEST_HOST}}:{{REMOTE_BIN}}/bm-agent
    # Deploy ralph and claude from operator's PATH (optional — skipped if not found)
    # claude-agent-acp is NOT copied from operator — operator's pnpm shim hardcodes operator's home paths
    # bm-test-user regenerates claude-agent-acp from their own pnpm store below
    for bin in ralph claude; do
        LOCAL_BIN=$(which "$bin" 2>/dev/null || true)
        if [ -n "$LOCAL_BIN" ]; then
            scp -q "$LOCAL_BIN" {{TEST_HOST}}:{{REMOTE_BIN}}/"$bin"
        fi
    done
    # Install pnpm and claude-agent-acp in bm-test-user home before generating wrapper.
    # Tests must deploy their own deps — never assume pre-installed state.
    ssh {{TEST_HOST}} bash -s << 'INSTALL_ACP'
    set -euo pipefail
    # Always set PNPM_HOME first so it resolves to bm-test-user's own home,
    # and add it to PATH before checking if pnpm is available.
    export PNPM_HOME="$HOME/.local/share/pnpm"
    export PATH="$PNPM_HOME:$PATH"
    # Install pnpm if not present even after PATH update
    if ! command -v pnpm >/dev/null 2>&1; then
        echo "  Installing pnpm for bm-test-user..."
        curl -fsSL https://get.pnpm.io/install.sh | PNPM_HOME="$PNPM_HOME" sh -
        export PATH="$PNPM_HOME:$PATH"
    fi
    # Ensure node is installed via pnpm
    pnpm env use --global lts 2>/dev/null || true
    # Install claude-agent-acp (idempotent)
    pnpm install -g @agentclientprotocol/claude-agent-acp
    echo "  ✓ claude-agent-acp installed via bm-test-user pnpm"
    INSTALL_ACP
    # Regenerate claude-agent-acp wrapper using bm-test-user's own pnpm and node.
    # bm-test-user has @agentclientprotocol/claude-agent-acp in their own pnpm store at
    # ~/.local/share/pnpm/ — use their own node and their own package paths.
    ssh {{TEST_HOST}} bash -s << 'REGEN_ACP'
    set -euo pipefail
    PNPM_DIR=$HOME/.local/share/pnpm
    ACP_PKG=$(ls $PNPM_DIR/global/5/.pnpm/ 2>/dev/null | grep '^@agentclientprotocol+claude-agent-acp@' | sort -V | tail -1 || true)
    [ -z "$ACP_PKG" ] && { echo 'ERROR: claude-agent-acp not in bm-test-user pnpm store' >&2; exit 1; }
    ACP_VERSION=${ACP_PKG#@agentclientprotocol+claude-agent-acp@}
    NODE_VERSION=$(ls $PNPM_DIR/nodejs/ 2>/dev/null | sort -V | tail -1 || true)
    NODE_BIN=$PNPM_DIR/nodejs/${NODE_VERSION}/bin/node
    ACP_INDEX=$PNPM_DIR/global/5/.pnpm/@agentclientprotocol+claude-agent-acp@${ACP_VERSION}/node_modules/@agentclientprotocol/claude-agent-acp/dist/index.js
    NP1=$PNPM_DIR/global/5/.pnpm/@agentclientprotocol+claude-agent-acp@${ACP_VERSION}/node_modules/@agentclientprotocol/claude-agent-acp/node_modules
    NP2=$PNPM_DIR/global/5/.pnpm/@agentclientprotocol+claude-agent-acp@${ACP_VERSION}/node_modules
    NP3=$PNPM_DIR/global/5/.pnpm/node_modules
    mkdir -p $HOME/.local/bin
    printf '#!/bin/sh\nif [ -z "$NODE_PATH" ]; then\n  export NODE_PATH="%s:%s:%s"\nelse\n  export NODE_PATH="%s:%s:%s:$NODE_PATH"\nfi\n"%s" "%s" "$@"\nexit $?\n' $NP1 $NP2 $NP3 $NP1 $NP2 $NP3 $NODE_BIN $ACP_INDEX > $HOME/.local/bin/claude-agent-acp
    chmod +x $HOME/.local/bin/claude-agent-acp
    echo '  ✓ claude-agent-acp wrapper regenerated using bm-test-user own pnpm'
    REGEN_ACP
    # Deploy GitHub App PEM file to the remote test user
    scp -q "{{TESTS_APP_PRIVATE_KEY_FILE}}" {{TEST_HOST}}:~/.config/github-apps/bm-test-app.pem
    # Copy test scripts
    scp -q "{{LOCAL_LIB}}" {{TEST_HOST}}:{{REMOTE_LIB}}
    scp -q {{LOCAL_PHASES}}/*.sh {{TEST_HOST}}:{{REMOTE_PHASES}}/
    ssh {{TEST_HOST}} 'chmod +x {{REMOTE_PHASES}}/*.sh'
    # Deploy GCP application default credentials for Vertex AI auth
    GCP_CREDS="$HOME/.config/gcloud/application_default_credentials.json"
    if [ -f "$GCP_CREDS" ]; then
        ssh {{TEST_HOST}} 'mkdir -p ~/.config/gcloud && rm -f ~/.config/gcloud/application_default_credentials.json'
        scp -q "$GCP_CREDS" {{TEST_HOST}}:~/.config/gcloud/application_default_credentials.json
    fi
    # Ensure git identity is configured (required for bm init)
    ssh {{TEST_HOST}} 'git config --global user.email 2>/dev/null || git config --global user.email "bm-test-user@botminter.dev"'
    ssh {{TEST_HOST}} 'git config --global user.name 2>/dev/null || git config --global user.name "BM Test User"'
    # Authenticate gh on the test user (clean wipes stale tokens).
    # Pipe the token via stdin to avoid exposing it in process args.
    # setup-git wires the credential helper so git push uses gh for HTTPS auth.
    echo "$TESTS_GH_TOKEN" | ssh {{TEST_HOST}} 'gh auth login --with-token && gh auth setup-git'
    # Read Vertex AI vars from operator shell — forwarded to bm-test-user env.sh so
    # bm brain-run's collect_env_vars() can pass them to the claude-agent-acp child process.
    VERTEX_PROJECT="${ANTHROPIC_VERTEX_PROJECT_ID:-}"
    VERTEX_ENABLED="${CLAUDE_CODE_USE_VERTEX:-}"
    VERTEX_REGION="${CLOUD_ML_REGION:-}"
    REMOTE_GCP_CREDS="{{REMOTE_HOME}}/.config/gcloud/application_default_credentials.json"
    # Generate env.sh on the remote — sourced by run-phase before each phase
    printf '%s\n' \
        'export BM="{{REMOTE_BIN}}/bm"' \
        'export BM_AGENT="{{REMOTE_BIN}}/bm-agent"' \
        'export TEAM="{{TEAM}}"' \
        'export ORG="{{ORG}}"' \
        'export REPO="{{REPO}}"' \
        'export FULL_REPO="{{FULL_REPO}}"' \
        'export PROJECT_REPO="{{PROJECT_REPO}}"' \
        'export FULL_PROJECT_REPO="{{FULL_PROJECT_REPO}}"' \
        'export PROFILE="{{PROFILE}}"' \
        'export BOARD="{{BOARD}}"' \
        'export TEAM_DIR="{{REMOTE_TEAM_DIR}}"' \
        'export TEAM_REPO="{{REMOTE_TEAM_REPO}}"' \
        'export REPORT="{{REMOTE_REPORT}}"' \
        'export LIB="{{REMOTE_LIB}}"' \
        'export CARGO_ROOT="{{REMOTE_STAGING}}"' \
        'export TUWUNEL_PORT="{{TUWUNEL_PORT}}"' \
        'export TESTS_APP_ID="{{TESTS_APP_ID}}"' \
        'export TESTS_APP_CLIENT_ID="{{TESTS_APP_CLIENT_ID}}"' \
        'export TESTS_APP_INSTALLATION_ID="{{TESTS_APP_INSTALLATION_ID}}"' \
        "export TESTS_APP_PRIVATE_KEY_FILE=\"{{REMOTE_HOME}}/.config/github-apps/bm-test-app.pem\"" \
        'export PATH="{{REMOTE_BIN}}:$PATH"' \
        "export CLAUDE_CODE_USE_VERTEX=\"${VERTEX_ENABLED}\"" \
        "export ANTHROPIC_VERTEX_PROJECT_ID=\"${VERTEX_PROJECT}\"" \
        "export CLOUD_ML_REGION=\"${VERTEX_REGION}\"" \
        "export GOOGLE_APPLICATION_CREDENTIALS=\"${REMOTE_GCP_CREDS}\"" \
        | ssh {{TEST_HOST}} 'cat > {{REMOTE_ENV}}'
    echo "Deploy complete."


# Initialize report file on remote
init-report:
    #!/usr/bin/env bash
    ssh {{TEST_HOST}} 'bash -l -c "source {{REMOTE_ENV}} && \
        BM_VERSION=\$(\$BM --version 2>/dev/null || echo unknown) && \
        GH_USER=\$(gh api user --jq .login 2>/dev/null || echo unknown) && \
        printf \"%s\n\" \
            \"# Exploratory Test Report: Sync & Bridge Idempotency\" \
            \"\" \
            \"**Date:** \$(date +%Y-%m-%d)\" \
            \"**Build:** \$BM_VERSION (local debug)\" \
            \"**Environment:** \$(uname -sm), podman rootless, gh (\$GH_USER)\" \
            \"**Test User:** {{TEST_USER}}@localhost (isolated)\" \
            \"\" \
            \"## Results\" \
            > \$REPORT"'

# Fetch report from remote to local
fetch-report:
    scp -q {{TEST_HOST}}:{{REMOTE_REPORT}} "{{LOCAL_REPORT}}" 2>/dev/null || echo "No report to fetch."

# ─── Keyring ───────────────────────────────────────────────────

# Idempotent: starts isolated keyring on remote if not running, reuses if alive
ensure-keyring:
    ssh {{TEST_HOST}} 'bash -l -c "source {{REMOTE_ENV}} && source {{REMOTE_LIB}} && ensure_keyring"'

# ─── Preflight ─────────────────────────────────────────────────

# Pre-flight check: verify remote environment is ready
preflight: ensure-keyring
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Pre-flight checks on {{TEST_HOST}}..."
    ssh {{TEST_HOST}} 'bash -l -c "source {{REMOTE_ENV}} && source {{REMOTE_LIB}} && \
        set -euo pipefail && \
        if ss -tlnp sport = :\$TUWUNEL_PORT 2>/dev/null | grep -q LISTEN; then \
            echo \"FATAL: Port \$TUWUNEL_PORT is in use\"; exit 1; \
        fi && \
        echo \"  ✓ Port \$TUWUNEL_PORT is free\" && \
        if load_isolated_keyring; then \
            echo \"  ✓ Isolated keyring running (pid=\$ISOLATED_DBUS_PID)\"; \
        else \
            echo \"FATAL: Isolated keyring not running\"; exit 1; \
        fi && \
        for tool in podman just gh curl jq; do \
            command -v \$tool >/dev/null 2>&1 || { echo \"FATAL: \$tool not found\"; exit 1; }; \
        done && \
        echo \"  ✓ All required tools available\" && \
        for bin in \$BM \$BM_AGENT; do \
            [ -x \$bin ] || { echo \"FATAL: \$bin not executable (run just deploy)\"; exit 1; }; \
        done && \
        echo \"  ✓ bm + bm-agent deployed\" && \
        gh auth status >/dev/null 2>&1 || { echo \"FATAL: gh not authenticated on {{TEST_USER}}\"; exit 1; } && \
        echo \"  ✓ gh authenticated\" && \
        CLAUDE_RESP=\$(echo \"say ok\" | claude --print --bare 2>&1) && \
        if echo \"\$CLAUDE_RESP\" | grep -qi \"ok\"; then \
            echo \"  ✓ Claude smoke test passed\"; \
        else \
            echo \"FATAL: Claude smoke test failed: \$CLAUDE_RESP\"; exit 1; \
        fi && \
        echo \"Pre-flight OK.\""'

# ─── Phase recipes ─────────────────────────────────────────────
# Each phase runs on the remote test user via SSH.
# env.sh provides all configuration; the phase script runs in a login shell.

[private]
run-phase phase timeout="300":
    timeout --signal=TERM --kill-after=15 {{timeout}} ssh {{TEST_HOST}} 'bash -l -c "source {{REMOTE_ENV}} && exec {{REMOTE_PHASES}}/{{phase}}"'

phase-b: ensure-keyring (run-phase "phase-b.sh")

phase-c: ensure-keyring (run-phase "phase-c.sh")

phase-d-session: ensure-keyring (run-phase "phase-d-session.sh" "900")

phase-e: ensure-keyring (run-phase "phase-e.sh")

phase-f: ensure-keyring (run-phase "phase-f.sh")

phase-g: (run-phase "phase-g.sh")

phase-h: ensure-keyring (run-phase "phase-h.sh" "1200")

# ─── Orchestration ─────────────────────────────────────────────

# Run all phases (B through H)
# Starts and ends with clean to ensure a known-good state.
all: clean deploy preflight init-report phase-b phase-c phase-d-session phase-e phase-f phase-h phase-g fetch-report clean

# Run only bridge + workspace phases (skip init, assume team exists)
bridge-and-workspace: ensure-keyring phase-c phase-d-session phase-e
